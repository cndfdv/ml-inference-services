# Имя модели для onnx-asr (скачивается с HuggingFace по имени):
#   gigaam-v3-ctc       — рекомендуется под CPU
#   gigaam-v3-e2e-ctc   — то же + пунктуация и нормализация текста
#   gigaam-v3-rnnt      — точнее, но на CPU заметно медленнее
MODEL_VERSION=gigaam-v3-ctc

# Кеш HuggingFace, куда onnx-asr кладёт скачанные веса. В docker монтируется
# как volume (./models), чтобы модель качалась один раз и переживала рестарты.
HF_HOME=/app/models

# Временная папка для загруженных аудио. Файл удаляется сразу после
# распознавания — сервис ничего не хранит (хранение и БД — в другом сервисе).
TMP_DIR=/app/tmp

# Сколько секунд простоя до выгрузки модели из RAM
IDLE_TTL=120

# Максимум секунд ожидания результата (очередь + инференс); дольше — 504
REQUEST_TIMEOUT=300

# Длина окна, на которые режется длинное аудио перед инференсом, сек.
# Длинный файл целиком уводит энкодер в OOM, поэтому режем. 0 — не резать.
CHUNK_SEC=30

# Сколько окон гонится одним батчем (больше — быстрее, но выше пик памяти)
CHUNK_BATCH_SIZE=8

# Аудио-предобработка: цепочка фильтров ffmpeg (значение -af), применяется к
# входному аудио перед распознаванием. Пусто — без фильтров.
#   highpass=f=100  — срезать низкочастотный гул/рокот
#   dynaudnorm      — выровнять громкость (помогает тихим/дальним спикерам)
#   loudnorm        — нормализация громкости по EBU R128 (альтернатива dynaudnorm)
#   afftdn          — шумодав (осторожно: агрессивный может ухудшить распознавание)
# Заметный эффект в основном на тихой/шумной записи; на чистой — небольшой.
AUDIO_FILTERS=highpass=f=100,dynaudnorm

# Число потоков CPU для onnxruntime — выставь по числу физических ядер
OMP_NUM_THREADS=4

# Порт на хосте, на котором будет доступен сервис
PORT=8000
