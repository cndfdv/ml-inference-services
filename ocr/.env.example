# Имя HF-модели PaddleOCR-VL для transformers (скачивается с HuggingFace по имени):
#   PaddlePaddle/PaddleOCR-VL       — базовая
#   PaddlePaddle/PaddleOCR-VL-1.5   — новее
#   PaddlePaddle/PaddleOCR-VL-1.6   — ещё новее (грузится как image-text-to-text)
MODEL_NAME=PaddlePaddle/PaddleOCR-VL

# Каким Auto-классом transformers грузить веса:
#   auto                — пробуем image-text-to-text, потом causal-lm (по умолчанию)
#   causal_lm           — принудительно AutoModelForCausalLM (базовая версия)
#   image_text_to_text  — принудительно AutoModelForImageTextToText (1.6)
MODEL_CLASS=auto

# Устройство инференса: cpu / cuda. Сервис рассчитан на CPU.
DEVICE=cpu

# Тип весов: float32 / bfloat16 / float16. На CPU держи float32 — bfloat16/float16
# на CPU медленные и не везде поддержаны.
TORCH_DTYPE=float32

# Промпт задачи для VLM. OCR: — распознать текст. Другие варианты:
# "Table Recognition:", "Formula Recognition:", "Chart Recognition:".
OCR_PROMPT=OCR:

# Потолок генерации на одну страницу (больше — можно длиннее текст, но медленнее)
MAX_NEW_TOKENS=2048

# С каким DPI рендерить страницы PDF в картинку перед OCR (выше — чётче, но медленнее)
PDF_DPI=150

# Кеш HuggingFace, куда transformers кладёт скачанные веса. В docker монтируется
# как volume (./models), чтобы веса качались один раз и переживали рестарты.
HF_HOME=/app/models

# Токен доступа HuggingFace. Нужен для приватных/gated-моделей и снимает лимиты
# анонимной загрузки. huggingface_hub читает его из окружения сам — код менять не
# надо. Получить: https://huggingface.co/settings/tokens (право read). Пусто —
# качаем анонимно (для публичных моделей ок).
HF_TOKEN=

# Временная папка для загруженных файлов. Файл удаляется сразу после
# распознавания — сервис ничего не хранит (хранение и БД — в другом сервисе).
TMP_DIR=/app/tmp

# Сколько секунд простоя до выгрузки модели из RAM (VLM прожорлив — держим дольше,
# чтобы реже платить за cold start)
IDLE_TTL=300

# Максимум секунд ожидания результата (очередь + инференс); дольше — 504.
# VLM на CPU медленный, особенно многостраничный PDF — таймаут большой.
REQUEST_TIMEOUT=600

# Разделитель страниц при склейке многостраничного PDF в общий текст ответа.
# Значение берётся из env ЛИТЕРАЛЬНО (\n переносом строки НЕ станет). По
# умолчанию (переменная не задана) используется "\n\n---\n\n" с настоящими
# переносами из кода — обычно менять не нужно, поэтому строка закомментирована.
# PAGE_SEPARATOR====

# Число потоков CPU для torch — выставь по числу физических ядер
OMP_NUM_THREADS=4

# Порт на хосте, на котором будет доступен сервис
PORT=8002
