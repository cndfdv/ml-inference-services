# Языки распознавания EasyOCR (через запятую). EasyOCR сам качает модели по языкам.
# Русский совместим с английским в одном ридере. Полный список кодов — в доках EasyOCR.
#   ru,en   — русский + английский (рекомендуется под домен)
#   en      — только английский
EASYOCR_OCR_LANGS=ru,en

# Каталог кеша моделей EasyOCR. В docker монтируется как volume (./models), чтобы
# модели качались один раз и переживали рестарты.
EASYOCR_MODULE_PATH=/app/models

# Группировать распознанные строки в абзацы (true/false). false — по строкам.
EASYOCR_PARAGRAPH=false

# int8-квантизация распознавателя EasyOCR (true/false): быстрее и меньше RAM.
# ВАЖНО: бэкенд квантизации (fbgemm) требует AVX2. На CPU без AVX2 (напр.
# дефолтный QEMU Virtual CPU у виртуалок) квантованный инференс падает с
# «Illegal instruction» (SIGILL). Сервис сам определяет AVX2 и на таких CPU
# автоматически откатывается на fp32, даже если тут true. Проверить свой CPU:
#   grep -o avx2 /proc/cpuinfo | head -1   (пусто — AVX2 нет)
EASYOCR_QUANTIZE=true

# С каким DPI рендерить страницы PDF в картинку перед OCR (выше — чётче, но медленнее)
EASYOCR_PDF_DPI=150

# Временная папка для загруженных файлов. Файл удаляется сразу после
# распознавания — сервис ничего не хранит (хранение и БД — в другом сервисе).
EASYOCR_TMP_DIR=/app/tmp

# Сколько секунд простоя до выгрузки ридера из RAM
EASYOCR_IDLE_TTL=300

# Максимум секунд ожидания результата (очередь + инференс); дольше — 504
EASYOCR_REQUEST_TIMEOUT=300

# Разделитель страниц при склейке многостраничного PDF в общий текст ответа.
# Значение берётся из env ЛИТЕРАЛЬНО (\n переносом строки НЕ станет). По
# умолчанию (переменная не задана) используется "\n\n---\n\n" с настоящими
# переносами из кода — обычно менять не нужно, поэтому строка закомментирована.
# EASYOCR_PAGE_SEPARATOR====

# Число потоков CPU для torch — выставь по числу физических ядер
EASYOCR_OMP_NUM_THREADS=4

# Порт на хосте, на котором будет доступен сервис
EASYOCR_PORT=8002

# Worker processes; every worker owns an independent model copy.
EASYOCR_WORKERS=1
