# Имя HF-модели для sentence-transformers (скачивается с HuggingFace по имени):
#   deepvk/USER-bge-m3              — русская bge-m3, сильное качество (dim 1024)
#   intfloat/multilingual-e5-base  — многоязычная, легче и быстрее (dim 768)
#   sergeyzh/rubert-tiny-turbo     — маленькая быстрая русская (dim 312)
#   sentence-transformers/all-MiniLM-L6-v2 — лёгкая англоязычная (dim 384)
MODEL_NAME=deepvk/USER-bge-m3

# Кеш HuggingFace, куда sentence-transformers кладёт скачанные веса. В docker
# монтируется как volume (./models), чтобы модель качалась один раз и переживала
# рестарты.
HF_HOME=/app/models

# Токен доступа HuggingFace. Нужен для приватных/gated-моделей и снимает лимиты
# анонимной загрузки. huggingface_hub читает его из окружения сам — код менять не
# надо. Получить: https://huggingface.co/settings/tokens (право read). Пусто —
# качаем анонимно (для публичных моделей ок).
HF_TOKEN=

# Сколько секунд простоя до выгрузки модели из RAM
IDLE_TTL=120

# Максимум секунд ожидания результата (очередь + инференс); дольше — 504
REQUEST_TIMEOUT=300

# Размер батча при кодировании (больше — быстрее, но выше пик памяти)
BATCH_SIZE=32

# L2-нормализация выходных векторов (true — удобно для косинусной близости)
NORMALIZE_EMBEDDINGS=true

# Префикс, добавляемый к каждому тексту перед кодированием. Пусто — без префикса.
# Дефолтной модели deepvk/USER-bge-m3 префикс НЕ нужен — она симметричная.
# Префикс нужен только асимметричным моделям e5 (intfloat/multilingual-e5-*):
# для них выставь EMBED_PREFIX=query: (с завершающим пробелом).
EMBED_PREFIX=

# Предел числа текстов в одном запросе (защита от OOM); больше — 422
MAX_TEXTS=256

# Число потоков CPU для torch — выставь по числу физических ядер
OMP_NUM_THREADS=4

# Порт на хосте, на котором будет доступен сервис
PORT=8001
