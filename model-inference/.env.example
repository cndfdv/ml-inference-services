# Defaults keep the APIs local; containers can join the model-inference network.
BIND_ADDRESS=127.0.0.1
E5_PORT=18101
USER_PORT=18102
OCR_PORT=18103
WHISPER_PORT=18104
E5_DEVICE=cuda
USER_DEVICE=cuda
OCR_DEVICE=cuda
WHISPER_DEVICE=cuda
E5_WORKERS=1
USER_WORKERS=1
OCR_WORKERS=1
WHISPER_WORKERS=1
WHISPER_BATCH_SIZE=1
MAX_BATCH_SIZE=16
MAX_BATCH_TOKENS=8192
BATCH_WAIT_MS=10
MAX_QUEUE_ITEMS=256
REQUEST_TIMEOUT_S=600
MAX_REQUEST_ITEMS=64
MAX_REQUEST_BODY_BYTES=67108864
CPU_THREADS=4
REC_BATCH_SIZE=6
MAX_AUDIO_DURATION_S=600
# Used only by the CPU overlay. Keep fp32 for closest test/production parity.
USER_CPU_VARIANT=fp32
